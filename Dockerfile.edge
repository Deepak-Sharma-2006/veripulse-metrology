# ==============================================================================
# VeriPulse Edge Vision & Reflex Loop Node
# Multi-Stage Build: C++ G-API Reflex Core + Python 120 FPS Orchestration
# ==============================================================================

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    git \
    libopencv-dev \
    python3 \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY edge_vision/ ./edge_vision/
COPY config/ ./config/
COPY models/ ./models/

# Compile C++ Edge Vision Reflex Binaries (AVX2 / NEON SIMD)
WORKDIR /build/edge_vision/build
RUN cmake -GNinja -DCMAKE_BUILD_TYPE=Release .. && ninja

# ------------------------------------------------------------------------------
# Runtime Image
# ------------------------------------------------------------------------------
FROM ubuntu:22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libopencv-core4.5d \
    libopencv-imgproc4.5d \
    libopencv-imgcodecs4.5d \
    libgomp1 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Copy built C++ binaries from builder stage
COPY --from=builder /build/edge_vision/build/veripulse_edge /app/edge_vision/bin/veripulse_edge

# Copy Python modules and configurations
COPY edge_vision/ /app/edge_vision/
COPY plc_bridge/ /app/plc_bridge/
COPY synthetic_streamer/ /app/synthetic_streamer/
COPY gateway_ipc/ /app/gateway_ipc/
COPY cloud_agent/ /app/cloud_agent/
COPY cloud_metrology_cool/ /app/cloud_metrology_cool/
COPY config/ /app/config/
COPY models/ /app/models/
COPY run_veripulse.py /app/run_veripulse.py
COPY *.py /app/

# Expose Modbus PLC (5020) and WebSocket IPC Gateway (8765)
EXPOSE 5020 8765

# Mount host shared memory for 120 FPS zero-copy IPC
VOLUME ["/dev/shm"]

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
    CMD python3 -c "import socket; s = socket.socket(); s.connect(('127.0.0.1', 8765)); s.close()" || exit 1

ENTRYPOINT ["python3", "run_veripulse.py"]
CMD ["--mode", "DRY_RUN", "--fps", "120.0"]
