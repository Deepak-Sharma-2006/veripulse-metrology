{
  "system": "VeriPulse Cyber-Physical Metrology System",
  "version": "1.0.0",
  "plc_profile": "Siemens S7-1500 / Modbus TCP Standard",
  "port": 5020,
  "unit_id": 1,
  "holding_registers": {
    "40001": {
      "address": 40001,
      "offset": 0,
      "key": "velocity_mms",
      "name": "Line Master Velocity",
      "data_type": "INT16",
      "unit": "mm/s",
      "engineering_unit": "m/s",
      "scale_to_eng": 0.001,
      "default_raw": 2500,
      "default_eng": 2.50,
      "range_min": 0,
      "range_max": 5000,
      "safety_min": 2250,
      "safety_max": 2750,
      "max_slew_rate": 150.0,
      "max_slew_rate_unit": "mm/s^2",
      "description": "Line master web velocity setpoint in mm/s (2500 mm/s = 2.50 m/s)"
    },
    "40002": {
      "address": 40002,
      "offset": 1,
      "key": "tension_dn",
      "name": "Web Tension Setpoint",
      "data_type": "INT16",
      "unit": "0.1 N",
      "engineering_unit": "N",
      "scale_to_eng": 0.1,
      "default_raw": 1500,
      "default_eng": 150.0,
      "range_min": 0,
      "range_max": 5000,
      "safety_min": 1250,
      "safety_max": 1750,
      "max_slew_rate": 15.0,
      "max_slew_rate_unit": "N/s",
      "description": "Web tension setpoint in 0.1 N increments (1500 = 150.0 N)"
    },
    "40003": {
      "address": 40003,
      "offset": 2,
      "key": "temp_dc",
      "name": "IR Dryer Zone 1 Temperature",
      "data_type": "INT16",
      "unit": "0.1 °C",
      "engineering_unit": "°C",
      "scale_to_eng": 0.1,
      "default_raw": 1200,
      "default_eng": 120.0,
      "range_min": 200,
      "range_max": 1800,
      "safety_min": 1050,
      "safety_max": 1350,
      "max_slew_rate": 1.5,
      "max_slew_rate_unit": "°C/min",
      "description": "IR dryer zone 1 temperature setpoint in 0.1 deg C (1200 = 120.0 deg C)"
    },
    "40004": {
      "address": 40004,
      "offset": 3,
      "key": "pump_drpm",
      "name": "Slurry Metering Pump Speed",
      "data_type": "INT16",
      "unit": "0.1 RPM",
      "engineering_unit": "RPM",
      "scale_to_eng": 0.1,
      "default_raw": 12000,
      "default_eng": 1200.0,
      "range_min": 0,
      "range_max": 30000,
      "safety_min": 10500,
      "safety_max": 13500,
      "max_slew_rate": 50.0,
      "max_slew_rate_unit": "RPM/s",
      "description": "Slurry metering pump rotational velocity in 0.1 RPM (12000 = 1200.0 RPM)"
    },
    "40005": {
      "address": 40005,
      "offset": 4,
      "key": "dancer_dgain",
      "name": "Dancer Roll Damping Gain",
      "data_type": "INT16",
      "unit": "0.01 Gain",
      "engineering_unit": "Gain",
      "scale_to_eng": 0.01,
      "default_raw": 500,
      "default_eng": 5.00,
      "range_min": 100,
      "range_max": 1000,
      "safety_min": 300,
      "safety_max": 700,
      "max_slew_rate": 2.0,
      "max_slew_rate_unit": "Gain/s",
      "description": "Dancer roll active hydraulic damping gain in 0.01 Gain (500 = 5.00 Gain)"
    }
  },
  "hmac_authentication": {
    "algorithm": "HMAC-SHA256",
    "secret_env_var": "VERIPULSE_HMAC_SECRET",
    "header_field": "hmac_sha256_signature",
    "enforce_signature": true
  }
}
